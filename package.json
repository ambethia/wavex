{
  "name": "wavex-workspace",
  "version": "0.1.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "WAVEx TypeScript-first framework workspace.",
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm typecheck && pnpm test && pnpm docs:check && pnpm api-docs:check",
    "typecheck": "pnpm -r typecheck",
    "test": "vp test run",
    "test:browser": "pnpm --filter todo test:browser && pnpm --filter swell test:browser",
    "ci": "pnpm check && pnpm build && pnpm package:check && pnpm editor:check && pnpm test:browser",
    "editor:check": "pnpm --filter wavex-vscode package:check",
    "package:check": "node scripts/check-packages.mjs",
    "package:artifacts": "node scripts/check-packages.mjs --output artifacts",
    "docs:skill": "node scripts/build-docs-skill.mjs",
    "docs:check": "node scripts/build-docs-skill.mjs --check",
    "api-docs:check": "node scripts/check-api-doc-comments.mjs"
  },
  "keywords": [
    "wavex",
    "wx",
    "vite",
    "lit",
    "convex"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ambethia/wavex.git"
  },
  "homepage": "https://github.com/ambethia/wavex#readme",
  "bugs": {
    "url": "https://github.com/ambethia/wavex/issues"
  },
  "packageManager": "pnpm@10.18.0",
  "pnpm": {
    "overrides": {
      "@types/node": "24.9.0",
      "vite": "npm:@voidzero-dev/vite-plus-core@0.1.24",
      "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.24"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "vite": "0.1.24",
        "vitest": "0.1.24"
      }
    }
  },
  "devDependencies": {
    "@types/node": "24.9.0",
    "lit": "3.3.3",
    "typedoc": "0.28.19",
    "typedoc-plugin-markdown": "4.12.0",
    "typescript": "6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.1.24",
    "vite-plus": "0.1.24",
    "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.24"
  }
}
