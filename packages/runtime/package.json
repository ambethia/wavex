{
  "name": "@wavex/runtime",
  "version": "0.1.0-alpha.0",
  "type": "module",
  "description": "WAVEx browser runtime primitives.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ambethia/wavex.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://github.com/ambethia/wavex#readme",
  "bugs": {
    "url": "https://github.com/ambethia/wavex/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./lit": {
      "types": "./dist/lit.d.ts",
      "default": "./dist/lit.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@wavex/core": "workspace:*"
  },
  "peerDependencies": {
    "lit": ">=3.0.0"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "license": "MIT"
}
