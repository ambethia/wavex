{
  "name": "wavex",
  "version": "0.1.0-alpha.0",
  "type": "module",
  "description": "WAVEx CLI.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ambethia/wavex.git",
    "directory": "packages/wavex"
  },
  "homepage": "https://github.com/ambethia/wavex#readme",
  "bugs": {
    "url": "https://github.com/ambethia/wavex/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "wavex": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@wavex/compiler": "workspace:*",
    "@wavex/core": "workspace:*",
    "@wavex/runtime": "workspace:*",
    "@lit-labs/ssr": "^3.3.0"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "license": "MIT",
  "peerDependencies": {
    "vite": "*"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
