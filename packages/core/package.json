{
  "name": "@wavex/core",
  "version": "0.1.0-alpha.0",
  "type": "module",
  "description": "Shared WAVEx project model and helpers.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ambethia/wavex.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/ambethia/wavex#readme",
  "bugs": {
    "url": "https://github.com/ambethia/wavex/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./capabilities": {
      "types": "./dist/capabilities.d.ts",
      "default": "./dist/capabilities.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "24.9.0"
  }
}
