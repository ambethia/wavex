{
  "name": "@wavex/vite-plugin",
  "version": "0.1.0-alpha.0",
  "type": "module",
  "description": "Vite plugin for WAVEx .wx files.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ambethia/wavex.git",
    "directory": "packages/vite-plugin"
  },
  "homepage": "https://github.com/ambethia/wavex#readme",
  "bugs": {
    "url": "https://github.com/ambethia/wavex/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@wavex/compiler": "workspace:*",
    "@wavex/core": "workspace:*",
    "@wavex/runtime": "workspace:*"
  },
  "peerDependencies": {
    "vite": ">=8.0.0 || ^0.1.24"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "client.d.ts"
  ],
  "license": "MIT"
}
